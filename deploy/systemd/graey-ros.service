[Unit]
Description=Graey core ROS 2 stack - status LEDs and navigation
After=graey-mavproxy.service
Requires=graey-mavproxy.service

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStart=/usr/bin/docker exec graey bash -c "source /opt/ros/humble/setup.bash && source /root/robotx_ws/install/setup.bash && ros2 launch robotx_graey_2026 core.launch.py"
ExecStop=-/usr/bin/docker exec graey pkill -f robotx_graey_2026
StandardOutput=append:/home/graey/robotx_ws/logs/graey-ros.log
StandardError=append:/home/graey/robotx_ws/logs/graey-ros.log

[Install]
WantedBy=multi-user.target
